    name: "libhdr10p_meta_interface_header",
    export_include_dirs: ["include"],
    vendor_available: true,
}

cc_library_headers {
    name: "libhdrinterface_header",
    export_include_dirs: ["include"],
    vendor_available: true,
}

cc_library_headers {
    name: "libgralloc4_headers_exynos",
    export_include_dirs: ["include"],
    vendor_available: true,
}
