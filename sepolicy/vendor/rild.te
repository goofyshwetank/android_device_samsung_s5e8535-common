set_prop(rild, vendor_radio_prop)

dontaudit rild system_prop:file read;

allow rild prov_efs_file:dir create_dir_perms;
allow rild prov_efs_file:file create_file_perms;
allow rild tun_device:chr_file rw_file_perms;
allow rild self:tun_socket create_socket_perms_no_ioctl;
allow rild self:capability net_admin;
